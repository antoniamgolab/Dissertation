keywords = {Battery electric vehicle,Charging locations,Choice behavior,Plug-in hybrid & electric vehicle},
mendeley-groups = {related work - fast charging importance},
number = {October},
pages = {255--272},
publisher = {Elsevier},
title = {{Demand drivers for charging infrastructure-charging behavior of plug-in electric vehicle commuters}},
url = {https://doi.org/10.1016/j.trd.2019.09.015},
volume = {76},
year = {2019}
}
