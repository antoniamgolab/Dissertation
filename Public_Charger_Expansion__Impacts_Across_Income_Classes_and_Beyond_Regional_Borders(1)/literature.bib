@article{AJANOVIC20161451,
title = {Dissemination of electric vehicles in urban areas: Major factors for success},
journal = {Energy},
volume = {115},
pages = {1451-1458},
year = {2016},
note = {Towards low carbon energy systems: engineering and economic perspectives},
issn = {0360-5442},
doi = {https://doi.org/10.1016/j.energy.2016.05.040},
url = {https://www.sciencedirect.com/science/article/pii/S0360544216306508},
author = {Amela Ajanovic and Reinhard Haas},
keywords = {Electric vehicles, Policy, Emissions, Sustainable mobility},
abstract = {Problems of transport become more pressing with increasing urbanisation. Although EVs (electric vehicles) are considered to contribute to reduction of greenhouse gas emissions and local air pollution caused by passenger car transport, their use is still very modest. The core objective of this paper is to identify the major impact factors for the broader dissemination of EVs in urban areas. We compare and analyse cities selected in nine different countries which are active in dissemination of EVs. The most important recommendation for policy makers is that all monetary and non-monetary promotion measures implemented should depend on the environmental benignity of the electricity generation mix. From society's point of view the promotion of EVs make sense only if it is ensured that a major share of electricity they use is generated from renewables. Since the final goal is not just to increase the number of EVs but to reduce emissions, cities also have to consider other e-mobility options such as trolleybuses, metros, trams and electro buses, as well as promote walking and biking, especially for short distances.}
}
